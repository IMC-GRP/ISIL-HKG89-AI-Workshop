@page "/"

<PageTitle>Home</PageTitle>

<div class="home-page">
    <section class="hero-section panel">
        <div class="hero-content">
            <p class="badge-label">Digital Solutions Department</p>
            <h1 class="hero-title">AI Workshop</h1>
            <p class="hero-tagline">
                Turn Ideas <span class="accent-text">Into Impact.</span>
            </p>
            <p class="hero-copy">
                A two-day innovation workshop where bold ideas become real solutions. Submit your idea,
                build your team, and create something that makes a difference.
            </p>
            <div class="hero-actions">
                <a class="btn-primary-glow" href="submit-idea">Submit Your Idea</a>
                <a class="btn-secondary-minimal" href="ideas">Explore Ideas</a>
            </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
            <div class="logo-glow"></div>
            <div class="logo-core">
                <img src="/images/partners/Digital_Solutions-removebg-preview.png" alt="" class="digital-solutions-logo" />
            </div>
            <div class="orbital-ring ring-one"></div>
            <div class="orbital-ring ring-two"></div>
            <div class="tech-line line-one"></div>
            <div class="tech-line line-two"></div>
            <div class="node node-one"></div>
            <div class="node node-two"></div>
            <div class="node node-three"></div>
            <div class="particle particle-one"></div>
            <div class="particle particle-two"></div>
            <div class="particle particle-three"></div>
            <div class="visual-grid"></div>
        </div>
    </section>

    <section class="vision-section">
        <p class="section-eyebrow">OUR VISION</p>
        <h2>Innovate. Collaborate. Build.</h2>
        <p class="section-copy">
            The AI Workshop brings teams together to solve real challenges with practical AI-powered solutions.
            It is a focused environment for experimentation, teamwork, and measurable business impact.
        </p>

        <div class="vision-grid">
            <article class="panel vision-card">
                <span class="vision-icon">✦</span>
                <h3>INNOVATE</h3>
                <p>Turn challenges into opportunities.</p>
            </article>
            <article class="panel vision-card">
                <span class="vision-icon">◉</span>
                <h3>COLLABORATE</h3>
                <p>Bring different skills and perspectives together.</p>
            </article>
            <article class="panel vision-card">
                <span class="vision-icon">⬢</span>
                <h3>BUILD</h3>
                <p>Transform ideas into working solutions.</p>
            </article>
        </div>
    </section>

    <section class="collaboration-section" aria-label="Collaboration partners">
        <div class="collaboration-banner panel">
            <img src="/images/partners/DigitalSolutions_Strauss.png" alt="Digital Solutions and Strauss collaboration banner" class="collaboration-banner-image" />
        </div>
    </section>

    <section class="process-section">
        <p class="section-eyebrow">HOW IT WORKS</p>
        <h2>From idea to impact.</h2>
        <div class="process-grid">
            <article class="panel process-item"><span>01</span><h3>Submit an Idea</h3></article>
            <article class="panel process-item"><span>02</span><h3>Review Ideas</h3></article>
            <article class="panel process-item"><span>03</span><h3>Select 4 Finalists</h3></article>
            <article class="panel process-item"><span>04</span><h3>Build Your Team</h3></article>
            <article class="panel process-item"><span>05</span><h3>Two-Day Workshop</h3></article>
            <article class="panel process-item"><span>06</span><h3>Final Presentations</h3></article>
        </div>
    </section>

    <section class="panel highlight-section">
        <article>
            <p class="value">4</p>
            <p class="label">FINAL IDEAS</p>
        </article>
        <article>
            <p class="value">2</p>
            <p class="label">DAYS</p>
        </article>
        <article>
            <p class="value">1</p>
            <p class="label">GOAL</p>
        </article>
        <article>
            <p class="value text-gradient">INNOVATE</p>
            <p class="label">TOGETHER</p>
        </article>
    </section>
</div>
